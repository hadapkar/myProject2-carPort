<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- List every installed app and read its APKs. CarPort is sideloaded, never on Play. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- First patch of an app must remove the original, which has a different signature. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only for checking and downloading CarPort updates from GitHub Releases. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional, user-granted: Android's exception that lets the smart play button open your
         music link in Samsung Browser from the background. Nothing is drawn over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".CarPortApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarPort">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android Auto requires media apps to accept voice search; playback is resumed in the session. -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

        <!-- Car media controls: Android Auto shows CarPort as a media app that mirrors whatever
             is playing on the phone (e.g. Samsung Browser) and forwards the car's controls. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Monochrome icon Android Auto uses for CarPort in its media bar and notifications. -->
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_launcher_monochrome" />
        <service
            android:name=".media.CarMediaService"
            android:exported="true"
            android:label="@string/app_name"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Only to be granted notification access, which Android requires for seeing other
             apps' media sessions. Notification contents are never read. -->
        <service
            android:name=".media.MediaAccessListener"
            android:exported="true"
            android:label="@string/media_access_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
